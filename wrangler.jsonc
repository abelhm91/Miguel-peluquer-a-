// Configuración de Cloudflare Workers. Pasos en el README («Publicar en Cloudflare»).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miguel-peluquer-a",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Conserva las variables y secretos creados en el panel de Cloudflare en cada despliegue.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pentinats-reservas",
      "database_id": "49c1446c-c1ad-45b5-b6c0-eaf9c26d6955",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
