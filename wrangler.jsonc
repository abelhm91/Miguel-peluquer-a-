// Configuración de Cloudflare Workers. Pasos en el README («Publicar en Cloudflare»).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pentinats-reservas",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pentinats-reservas",
      // Sustituir por el id que devuelve: npx wrangler d1 create pentinats-reservas
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
